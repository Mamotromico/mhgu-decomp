{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/baserom/**"
  ],
  "lsp": {
    "jdtls": {
      "settings": {
        "java": {
          "project": {
            "referencedLibraries": [
              "/opt/ghidra/Ghidra/Framework/**/lib/*.jar",
              "/opt/ghidra/Ghidra/Features/Base/lib/*.jar"
            ]
          }
        }
      },
      "initialization_options": {
        "settings": {
          "java": {
            "project": {
              "referencedLibraries": [
                "/opt/ghidra/Ghidra/Framework/**/lib/*.jar",
                "/opt/ghidra/Ghidra/Features/Base/lib/*.jar"
              ]
            }
          }
        }
      }
    }
  }
}
